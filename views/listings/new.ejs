<% layout("/layouts/boilerplate")%>
    <div class="row mt-3">
        <div class="col-8 offset-2">
            <br>
            <h3 style="text-align:center">Create a new Listing</h3>
            <form action="/listings" method="POST" novalidate class="needs-validation">
                <div class="mb-3">
                    <!-- Title -->
                    <label for="title" class="form-label">Title</label>
                    <input type="text" name="listing[title]" class="form-control" placeholder="Add a catchy title"
                        required>
                    <div class="valid-feedback">Title looks good!</div>
                </div>
                <div class="mb-3">
                    <!-- Description -->
                    <label for="description" class="form-label">Description</label>
                    <textarea type="text" name="listing[description]" class="form-control" required></textarea>
                    <div class="invalid-feedback">Please enter short Description!</div>
                </div>
                <div class="mb-3">
                    <!-- Image -->
                    <label for="image" class="form-label">Image</label>
                    <input type="text" name="listing[image]" class="form-control">
                </div>
                <div class="row">
                    <div class="mb-3 col-md-4">
                        <!-- Price -->
                        <label for="price" class="form-label">Price</label>
                        <input type="number" name="listing[price]" class="form-control" placeholder="1200" required>
                        <div class="invalid-feedback">Price should be valid!</div>
                    </div>
                    <div class="mb-3 col-md-8">
                        <!-- Country -->
                        <label for="country" class="form-label">Country</label>
                        <input type="text" name="listing[country]" class="form-control" placeholder="India" required>
                        <div class="invalid-feedback">Country name should be valid!</div>
                    </div>
                </div>
                <div class="mb-3">
                    <!-- Location -->
                    <label for="location" class="form-label">Location</label>
                    <input type="text" name="listing[location]" class="form-control" placeholder="Jaipur , Rajasthan"
                        required>
                    <div class="invalid-feedback">Location should be valid!</div>
                </div>
                <!-- Add Button -->
                <button class="btn btn-dark add-btn">Add</button>
                <br>
                <br>
                <br>
            </form>
        </div>
    </div>