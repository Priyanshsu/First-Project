<% layout("/layouts/boilerplate") %>
    <main class="error-page" aria-labelledby="error-title">
        <section class="error-card" role="alert">
            <div class="error-icon" aria-hidden="true">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>
            <p class="error-eyebrow">Something went wrong</p>
            <h1 id="error-title" class="error-title">
                <%= statusCode || 500 %>
            </h1>
            <p class="error-message">
                <%= message || "We couldn't complete your request. Please try again." %>
            </p>
            <a class="btn error-home-btn" href="/listings">
                <i class="fa-solid fa-house me-2" aria-hidden="true"></i>Back to home
            </a>
        </section>
    </main>